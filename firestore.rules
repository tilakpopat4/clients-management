rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Schema Validators
    function isValidClient(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (data.name is string && data.name.size() > 0 && data.name.size() <= 200)
        && (!('company' in data) || (data.company is string && data.company.size() <= 200))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('rate' in data) || (data.rate is number || data.rate is int))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50));
    }

    function isValidInvoice(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.size() <= 100))
        && (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 200))
        && (!('totalAmount' in data) || (data.totalAmount is number || data.totalAmount is int))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50));
    }

    function isValidWorkItem(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (!('title' in data) || (data.title is string && data.title.size() <= 300))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50));
    }

    function isValidProfile(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200));
    }

    function isValidNote(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (!('title' in data) || (data.title is string && data.title.size() <= 300))
        && (!('content' in data) || (data.content is string && data.content.size() <= 5000));
    }

    // Path Rules
    match /clients/{clientId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidId(clientId) && isValidClient(incoming());
      allow update: if isOwner(existing().userId) && isOwner(incoming().userId) && isValidClient(incoming());
    }

    match /invoices/{invoiceId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidId(invoiceId) && isValidInvoice(incoming());
      allow update: if isOwner(existing().userId) && isOwner(incoming().userId) && isValidInvoice(incoming());
    }

    match /workItems/{workItemId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidId(workItemId) && isValidWorkItem(incoming());
      allow update: if isOwner(existing().userId) && isOwner(incoming().userId) && isValidWorkItem(incoming());
    }

    match /profiles/{profileId} {
      allow read: if isSignedIn();
      allow create: if isOwner(incoming().userId) && isValidId(profileId) && (profileId == request.auth.uid || incoming().userId == request.auth.uid) && isValidProfile(incoming());
      allow update, delete: if isOwner(existing().userId) && isOwner(incoming().userId) && isValidProfile(incoming());
    }

    match /notes/{noteId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidId(noteId) && isValidNote(incoming());
      allow update: if isOwner(existing().userId) && isOwner(incoming().userId) && isValidNote(incoming());
    }

    match /blocked_users/{userId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}
